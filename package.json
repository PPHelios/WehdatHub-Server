{
  "name": "AqarChat",
  "version": "2.2.0",
  "description": "Enterprise Real Estate WhatsApp Ingestion, Valuation & Inventory Engine",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "audit:schema": "node scripts/audit-db-schema.js",
    "test:pipeline": "node --env-file=.env tests/test_search_pipeline.js",
    "test:search:db": "node --env-file=.env tests/test_search_db.js",
    "schema:export": "node --env-file=.env scripts/export-schema.js",
    "schema:reference": "node scripts/schema-reference.js",
    "eval:ai": "node --env-file=.env scripts/eval-ai.js",
    "test:unit": "node --test tests/e2e.test.js",
    "test:contracts": "jest tests/contract-guard.test.js --runInBand",
    "test:safeguards": "jest tests/safeguards.test.js --runInBand",
    "test:router": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/router --runInBand",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js --maxWorkers=4 --workerIdleMemoryLimit=1500MB --testPathIgnorePatterns /node_modules/ tests/e2e.test.js tests/browser/ tests/heavy/",
    "test:fast": "node --test tests/e2e.test.js && node --experimental-vm-modules node_modules/jest/bin/jest.js --maxWorkers=4 --workerIdleMemoryLimit=1500MB tests/parity tests/contract-guard tests/visibility-guard tests/safeguards tests/api tests/unit tests/web/unit tests/web/search tests/web/data-entry",
    "test:heavy": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/heavy",
    "test:main-paths": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testMatch '**/tests/browser/main-paths.test.js' --testPathIgnorePatterns /node_modules/",
    "test:browser": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testMatch '**/tests/browser/**/*.test.js' --testPathIgnorePatterns /node_modules/",
    "test:ci": "npm run test:unit && npm run test:jest && npm run test:heavy",
    "test": "npm run audit:schema && npm run test:pipeline && npm run test:ci",
    "migrate": "node --env-file=.env scripts/migrate.js",
    "onboard": "node --env-file=.env scripts/onboard.js",
    "flyer:samples": "node scripts/render-flyer-samples.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/harness/clean-env.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/tests/e2e.test.js",
      "<rootDir>/tests/browser/"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "@resvg/resvg-js": "2.6.2",
    "@supabase/supabase-js": "2.118.0",
    "compression": "1.8.2",
    "dotenv": "18.0.8",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "heic2any": "^0.0.4",
    "html-react-parser": "5.2.17",
    "htmx.org": "2.0.11",
    "jszip": "3.10.2",
    "leaflet": "^1.9.4",
    "multer": "2.5.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "protomaps-leaflet": "^5.1.0",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@mapbox/vector-tile": "^3.0.0",
    "jest": "29.7.0",
    "pbf": "^5.1.2",
    "playwright": "^1.63.0",
    "pmtiles": "^4.5.0",
    "supertest": "7.3.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "uuid": "11.1.1",
    "fflate": "0.8.3"
  }
}
